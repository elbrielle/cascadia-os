---
// ============================================================================
//  /blog/tagged/[slug]/  —  posts filtered to one Substack tag
// ----------------------------------------------------------------------------
//  Mirrors blog.astro's structure but pre-filters the post list to only those
//  carrying the route slug. Generated statically at build time via
//  getStaticPaths — one route per tag the archive returns. View-transitions
//  (set up in Layout.astro) make navigating between /blog/ and these routes
//  smooth-cross-fade instead of hard-reload.
// ============================================================================
import Layout from "../../../layouts/Layout.astro";
import Window from "../../../components/Window.astro";
import TagsWindow from "../../../components/TagsWindow.astro";
import { getPosts, getTags, formatDate, SUBSTACK_FEED_URL } from "../../../lib/substack.js";

export async function getStaticPaths() {
  const [posts, tags] = await Promise.all([getPosts(), getTags()]);
  return tags.map((tag) => ({
    params: { slug: tag.slug },
    props: { tag, posts, tags },
  }));
}

const { tag, posts, tags } = Astro.props;
const filtered = posts.filter((p) =>
  Array.isArray(p.tags) && p.tags.some((t) => t.slug === tag.slug)
);
---

<Layout title={`Elisha Lucero — Blog — ${tag.name}`} pageTitle="Blog" current="blog">

  <div class="layout__cell blog__posts">
  <Window id="posts" title="Posts" width={560}>
    <a class="rss-corner" data-icon="rss" href={SUBSTACK_FEED_URL} target="_blank" rel="noopener" aria-label="Subscribe via RSS"></a>
    <div class="filter-pill">
      <span class="filter-pill__label">Tagged with</span>
      <span class="filter-pill__tag">"{tag.name}"</span>
      <a class="filter-pill__clear" href="/blog/" aria-label="Clear filter">✕</a>
    </div>
    <h2>Posts</h2>
    <ul class="panel-list">
      {filtered.length === 0 ? (
        <li class="panel post">
          <p style="font-size: var(--text-sm); color: var(--color-text-muted);">
            No posts under this tag yet — try clearing the filter.
          </p>
        </li>
      ) : (
        filtered.map((post) => (
          <li class="panel post">
            <span class="post__date">{formatDate(post.date)}</span>
            <a class="post__title" href={post.link} target="_blank" rel="noopener">{post.title}</a>
            {post.excerpt && (
              <p style="font-size: var(--text-sm); color: var(--color-text-muted);">{post.excerpt}</p>
            )}
            <a class="btn" href={post.link} target="_blank" rel="noopener">Read on Substack →</a>
          </li>
        ))
      )}
    </ul>
  </Window>
  </div>

  <div class="layout__cell blog__tags">
  <TagsWindow tags={tags} activeSlug={tag.slug} />
  </div>

</Layout>
