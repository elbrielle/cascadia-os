---
import Layout from "../layouts/Layout.astro";
import Window from "../components/Window.astro";
// Route-split (fingerprinted ?url → /_astro, immutable-cached). explorer drives
// the <details.folder> file tree; shared with /about, Vite dedups to one file.
import explorerScript from "../scripts/explorer.js?url";
---

<Layout title="Elisha Lucero — Work" pageTitle="Work" current="work">

  <div class="layout__cell work__selected">
  <Window id="client" title="File Explorer" width={680}>
    <div class="explorer">
      <div class="explorer__bar">
        <span class="explorer__bar-icon" data-icon="folder" aria-hidden="true"></span>
        <span class="explorer__path">C:\Work</span>
      </div>

      <details class="folder" open data-m-mobile="closed">
        <summary class="folder__head">
          <span class="folder__icon" data-icon="folder" aria-hidden="true"></span>
          <span class="folder__name">Apps</span>
          <span class="folder__count">3 items</span>
        </summary>
        <ul class="panel-list folder__body">
          <li class="panel work-item" id="work-idk" style="--accent: var(--color-accent);">
            <div class="work-item__header">
              <span class="work-item__icon" data-icon="idk" aria-hidden="true"></span>
              <h3>IDK Can You?</h3>
            </div>
            <p>
              A K-12 classroom app for autonomous hall passes and device checkouts.
              Time limits, ban systems, device history, and accountability without
              interrupting the lesson.
            </p>
            <div class="project-links">
              <a class="pixel-link" href="https://www.idkcanu.com/" target="_blank" rel="noopener">
                <span class="pixel-link__icon" data-icon="idk" aria-hidden="true"></span>
                <span class="pixel-link__label">Website</span>
              </a>
              <a class="pixel-link" href="https://play.google.com/store/apps/details?id=com.idkcanu.app" target="_blank" rel="noopener">
                <span class="pixel-link__icon" data-icon="play" aria-hidden="true"></span>
                <span class="pixel-link__label">Google Play</span>
              </a>
            </div>
          </li>
          <li class="panel work-item" id="work-framedeck" style="--accent: #0f6f8f;">
            <div class="work-item__header">
              <span class="work-item__icon" data-icon="play" aria-hidden="true"></span>
              <h3>FrameDeck</h3>
            </div>
            <p>
              A Chrome extension that turns your open tabs into an autoscrolling slidedeck.
            </p>
            <div class="project-links">
              <a class="pixel-link" href="https://github.com/elbrielle/FrameDeck" target="_blank" rel="noopener">
                <span class="pixel-link__icon" data-icon="github" aria-hidden="true"></span>
                <span class="pixel-link__label">GitHub</span>
              </a>
            </div>
          </li>
          <li class="panel work-item" id="work-doplarrchaptarr" style="--accent: #c84020;">
            <div class="work-item__header">
              <span class="work-item__icon" data-icon="bot" aria-hidden="true"></span>
              <h3>DoplarrChaptarr</h3>
            </div>
            <p>
              A personal fork of Doplarr that adds Chaptarr support, so one Discord bot
              can request movies, shows, ebooks, and audiobooks across a self-hosted media
              stack.
            </p>
            <div class="project-links">
              <a class="pixel-link" href="https://github.com/elbrielle/DoplarrChaptarr" target="_blank" rel="noopener">
                <span class="pixel-link__icon" data-icon="github" aria-hidden="true"></span>
                <span class="pixel-link__label">GitHub</span>
              </a>
            </div>
          </li>
        </ul>
      </details>

      <details class="folder">
        <summary class="folder__head">
          <span class="folder__icon" data-icon="folder" aria-hidden="true"></span>
          <span class="folder__name">Curriculum</span>
          <span class="folder__count">2 items</span>
        </summary>
        <ul class="panel-list folder__body">
          <li class="panel work-item" id="work-cce" style="--accent: #1a8c5a;">
            <div class="work-item__header">
              <span class="work-item__icon" data-icon="cce" aria-hidden="true"></span>
              <h3>CCE Curriculum</h3>
            </div>
            <p>
              A 36-week Career and College Explorations curriculum built as a
              source-grounded MkDocs site, using Hats and Ladders and Xello as
              supplementary materials.
            </p>
            <div class="project-links">
              <a class="pixel-link" href="https://elbrielle.github.io/cce-curriculum/latest/" target="_blank" rel="noopener">
                <span class="pixel-link__icon" data-icon="cce" aria-hidden="true"></span>
                <span class="pixel-link__label">View curriculum</span>
              </a>
            </div>
          </li>
          <li class="panel work-item" id="work-it" style="--accent: #3949ab;">
            <div class="work-item__header">
              <span class="work-item__icon" data-icon="bot" aria-hidden="true"></span>
              <h3>Innovative Technology Modules</h3>
            </div>
            <p>
              A curated set of CTE Innovative Technology units, animation,
              graphic design, 3D modeling, AI, AR, and VR, built in Canvas with
              custom HTML and inline CSS. Each lesson opens as the real module,
              video and interactive scenes included.
            </p>
            <div class="project-links">
              <a class="pixel-link" href="https://elbrielle.github.io/innovative-technology/" target="_blank" rel="noopener">
                <span class="pixel-link__icon" data-icon="bot" aria-hidden="true"></span>
                <span class="pixel-link__label">View modules</span>
              </a>
            </div>
          </li>
        </ul>
      </details>

      <details class="folder" data-m-mobile="open">
        <summary class="folder__head">
          <span class="folder__icon" data-icon="folder" aria-hidden="true"></span>
          <span class="folder__name">Services</span>
          <span class="folder__count">1 item</span>
        </summary>
        <ul class="panel-list folder__body">
          <li class="panel work-item" id="work-brielle" style="--accent: #d45886;">
            <div class="work-item__header">
              <span class="work-item__icon" data-icon="pc" aria-hidden="true"></span>
              <h3>Brielle Builds</h3>
            </div>
            <p>
              A flat-rate DFW PC build and repair service.
            </p>
            <div class="project-links">
              <a class="pixel-link" href="https://briellebuilds.com/" target="_blank" rel="noopener">
                <span class="pixel-link__icon" data-icon="pc" aria-hidden="true"></span>
                <span class="pixel-link__label">Website</span>
              </a>
            </div>
          </li>
        </ul>
      </details>
    </div>
  </Window>
  </div>

  <div class="layout__cell work__resume">
  <Window id="resume" title="resume.doc" width={460}>
    <div class="resume">
      <header class="resume__head">
        <h2 class="resume__name">Elisha Lucero</h2>
        <p class="resume__tagline">Tech educator · curriculum designer · builder</p>
        <p class="resume__sub">Irving ISD · 2025–26 Campus Teacher of the Year &amp; District Finalist</p>
        <ul class="resume__contact">
          <li><a href="https://www.linkedin.com/in/elisha-lucero" target="_blank" rel="noopener">linkedin.com/in/elisha-lucero</a></li>
          <li><a href="mailto:luceroelisha@icloud.com">luceroelisha@icloud.com</a></li>
        </ul>
        <a class="btn btn--primary resume__download" href="/resume/elisha-lucero-resume.pdf" download>Download PDF →</a>
      </header>

      <hr class="resume__rule" />

      <section class="resume__section">
        <h3>Summary</h3>
        <p class="resume__summary">Tech educator, curriculum designer, and technical builder with a foundation in computer and cognitive science (B.A. Cognitive Systems), where I studied how cognition is modeled in machine learning and intelligent systems. I design career-readiness and technology curricula that move students into real project work; I build tools to rectify systems that feel too brittle, slow, or indifferent to how people move through their day.</p>
      </section>

      <hr class="resume__rule" />

      <details class="resume__section m-collapse" open>
        <summary><h3>Skills</h3></summary>
        <ul class="cli">
          <li><strong>Languages &amp; frameworks:</strong> HTML/CSS, JavaScript, Python, SQL, Flutter/Dart, Flask</li>
          <li><strong>Infrastructure &amp; systems:</strong> Docker, Linux, Google Workspace, web hosting, DNS/domain administration</li>
          <li><strong>Data &amp; tools:</strong> Power Apps, SharePoint, Power BI, SPSS, Jira, Apps Script automation, local LLM deployment</li>
          <li><strong>Creative &amp; media:</strong> Adobe Creative Suite, Final Cut Pro, CapCut, Logic Pro, Riverside</li>
        </ul>
      </details>

      <hr class="resume__rule" />

      <details class="resume__section m-collapse" open>
        <summary><h3>Experience</h3></summary>

        <div class="resume__job">
          <div class="resume__job-head">
            <span class="resume__role">Bowie MS · Innovative Technology &amp; Publication</span>
            <span class="resume__date">Aug 2023 – Present</span>
          </div>
          <p class="resume__org">Irving ISD · Irving, TX</p>
          <ul class="cli">
            <li>Design and teach project-based CAD, Immersive Media, and AI/Robotics courses grounded in real-world problem-solving and student voice.</li>
            <li>Lead student media production across yearbook, journalism, and campus broadcasting.</li>
            <li>Named 2025–26 Campus Teacher of the Year and District finalist for equity-focused, student-centered instruction.</li>
            <li>Launched campus Student Council and first CTSO, creating leadership and state/national competition pathways for 100+ students.</li>
          </ul>
        </div>

        <div class="resume__job">
          <div class="resume__job-head">
            <span class="resume__role">Irving ISD STEM Camp · Administrator &amp; Facilitator</span>
            <span class="resume__date">Summer 2026</span>
          </div>
          <p class="resume__org">Irving ISD · Irving, TX</p>
          <ul class="cli">
            <li>Directed staff and curriculum for a 350-camper, four-grade STEM program spanning robotics, digital fabrication, and coding; designed the systems for student placement, staffing, supplies, and scheduling.</li>
            <li>Built the camp's operational tooling: custom HTML/CSS attendance tracking backed by Google Apps Script, Python scripts that automated badge generation, rosters, and mail-merge for parent communications.</li>
            <li>Designed a unified SharePoint and Power BI system to serve as a single source of truth for camp administration.</li>
          </ul>
        </div>

        <div class="resume__job">
          <div class="resume__job-head">
            <span class="resume__role">Bowie MS · 8th Grade ELAR / ESL Teacher</span>
            <span class="resume__date">Aug 2021 – Jul 2023</span>
          </div>
          <p class="resume__org">Irving ISD · Irving, TX</p>
          <ul class="cli">
            <li>Taught Honors RLA/ESL in a high-performing PLC, supporting literacy growth and language development.</li>
          </ul>
        </div>

        <div class="resume__job">
          <div class="resume__job-head">
            <span class="resume__role">The Haven · Systems Administrator</span>
            <span class="resume__date">Jun 2021 – Aug 2022</span>
          </div>
          <ul class="cli">
            <li>Administered technical infrastructure for a distributed digital arts platform, including Google Workspace shared drives, user access roles, domain registration, DNS routing, and website launch support.</li>
            <li>Led project coordination through Zoom facilitation, Jira/Atlassian workflow management, ticket tracking, and team training/onboarding.</li>
          </ul>
        </div>

        <div class="resume__job">
          <p class="resume__org">Earlier: YMCA Childcare Group Leader, Johnson MS Substitute, and UBC Teaching Assistant (2018–2021).</p>
        </div>
      </details>

      <hr class="resume__rule" />

      <details class="resume__section m-collapse" open>
        <summary><h3>Education &amp; certifications</h3></summary>
        <div class="resume__job">
          <div class="resume__job-head">
            <span class="resume__role">B.A. Cognitive Systems</span>
            <span class="resume__date">UBC</span>
          </div>
          <p class="resume__org">Minor in Creative Writing · University of British Columbia</p>
        </div>
        <ul class="cli">
          <li>TExES 7–12 ELAR, PPR &amp; ESL Teaching Certification · ACT Dallas Alternative Certification.</li>
          <li>Singley Academy · Digital Media &amp; Game Design (CTE).</li>
        </ul>
      </details>
    </div>
  </Window>
  </div>

  {/* File-tree expand/collapse + scroll-to-target (external + fingerprinted). */}
  <script is:inline src={explorerScript}></script>

</Layout>
