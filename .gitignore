# ============================================================================
#  .gitignore  —  files git should NOT track
# ----------------------------------------------------------------------------
#  These are either generated, downloaded, or machine-specific, so there's no
#  point storing them in version control. Anyone who clones the repo recreates
#  them by running `npm install` and `npm run build`.
# ============================================================================

# Installed dependencies (huge, regenerated by `npm install`)
node_modules/

# Astro build output + cache
dist/
.astro/

# Logs + environment files
*.log
.env
.env.*
!.env.example

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python bytecode (scripts/pixelate-wallpaper.py)
__pycache__/
*.pyc
